{
  "name": "hispanicoders",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "postbuild": "node scripts/generate-sitemap.mjs && react-snap",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "lint": "oxlint src api",
    "preview": "vite preview"
  },
  "reactSnap": {
    "source": "dist",
    "skipThirdPartyRequests": true,
    "puppeteerExecutablePath": "C:/Program Files/Google/Chrome/Application/chrome.exe",
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "include": [
      "/",
      "/about",
      "/careers",
      "/contact",
      "/hire-latam-developers",
      "/how-it-works",
      "/industries",
      "/latam-vs-apac",
      "/privacy-policy",
      "/resources",
      "/resources/hire-latam-developers-us-startups",
      "/resources/staff-augmentation-vs-freelance-marketplaces",
      "/resources/latam-vs-us-hiring-timeline",
      "/resources/how-to-evaluate-latam-engineers",
      "/resources/hiring-timeline-blueprint",
      "/resources/scale-from-1-to-10-hires",
      "/resources/nearshoring-latin-america",
      "/staff-augmentation",
      "/staff-augmentation-vs-in-house-hiring",
      "/talent",
      "/terms-of-service",
      "/why-latam"
    ]
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.20",
    "tailwindcss": "^3.4.17",
    "react-snap": "^1.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.1"
  }
}
