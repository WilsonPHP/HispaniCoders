Options -MultiViews

<IfModule mod_env.c>
    SetEnv HISPANICODERS_GMAIL_USERNAME "wilson@hispanicoders.com"
    SetEnv HISPANICODERS_GMAIL_APP_PASSWORD "REPLACE_WITH_GOOGLE_APP_PASSWORD"
</IfModule>

<IfModule mod_mime.c>
    AddType text/javascript .js .mjs
    AddType text/css .css
    AddType application/json .json
    AddType image/svg+xml .svg .svgz
    AddType application/wasm .wasm
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(js|mjs|css|json|svg|wasm)$">
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Return 410 Gone for known phishing/fake-webmail probe paths
    RewriteRule ^wmaildc/ - [R=410,L,NC]
    RewriteRule ^public_html/webmail/?$ - [R=410,L,NC]
    RewriteRule ^webmail/?$ - [R=410,L,NC]
    RewriteRule ^mail/?$ - [R=410,L,NC]
    RewriteRule ^cpanel/?$ - [R=410,L,NC]

    # Return 410 Gone for internal project folders that must not be public
    RewriteRule ^src(/|$) - [R=410,L,NC]
    RewriteRule ^dist(/|$) - [R=410,L,NC]
    RewriteRule ^public(/|$) - [R=410,L,NC]
    RewriteRule ^\.git(/|$) - [R=410,L,NC]

    # Return 410 Gone for all WordPress paths (previously indexed, now removed)
    RewriteRule ^wp-includes/ - [R=410,L]
    RewriteRule ^wp-content/ - [R=410,L]
    RewriteRule ^wp-admin/ - [R=410,L]
    RewriteRule ^wp-login\.php - [R=410,L]
    RewriteRule ^wp-cron\.php - [R=410,L]
    RewriteRule ^xmlrpc\.php - [R=410,L]
    RewriteRule ^wp-json/ - [R=410,L]
    RewriteRule ^locations\.kml - [R=410,L]

    # 301 redirects from old WordPress pages to new equivalents
    RewriteRule ^outsourcing-development-blog/?$ /resources/ [R=301,L]
    RewriteRule ^our-outsourcing-development-services/?$ /staff-augmentation/ [R=301,L]
    RewriteRule ^better-business-with-outsourcing-development/?$ /resources/ [R=301,L]
    RewriteRule ^hispanicoders-outsourcing-software-development/?$ / [R=301,L]
    RewriteRule ^outsourcing-software-why-outsource-in-argentina/?$ /why-latam/ [R=301,L]

    RewriteRule ^api/ - [L]
    RewriteRule ^assets/ - [L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule . /index.html [L]
</IfModule>
